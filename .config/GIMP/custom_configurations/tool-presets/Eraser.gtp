# GIMP tool preset file

(icon-name "gimp-tool-eraser")
(name "Eraser")
(tool-options "GimpEraserOptions"
    (tool "gimp-eraser-tool")
    (foreground
        (color "HSVA float" 16 "\24\363\175\77m\306a\77\346\243U\77\0\0\200\77" 0))
    (brush "2. Block 01")
    (dynamics "Pressure Opacity")
    (palette "Color History")
    (brush-size 80)
    (gradient-reverse yes))
(use-fg-bg no)
(use-opacity-paint-mode yes)
(use-brush yes)
(use-dynamics yes)
(use-mypaint-brush no)
(use-gradient no)
(use-pattern no)
(use-palette no)
(use-font no)

# end of GIMP tool preset file
