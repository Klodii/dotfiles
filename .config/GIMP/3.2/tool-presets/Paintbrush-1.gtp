# GIMP tool preset file

(icon-name "gimp-tool-paintbrush")
(icon-pixbuf "")
(name "MyPenBlue")
(tool-options "GimpPaintOptions"
    (tool "gimp-paintbrush-tool")
    (foreground
        (color "R'G'B'A double" 32 "\0\0\0\100\34\34\234\77\0\0\0\200\331\325\325\77\0\0\0\200\376\374\354\77\0\0\0\0\0\0\360\77" 0))
    (brush "1. Pixel")
    (dynamics "Pressure Opacity")
    (pattern "Pine")
    (gradient "FG to BG (RGB)")
    (palette "Color History")
    (brush-size 6)
    (brush-spacing 0.20000000000000001)
    (application-mode incremental)
    (jitter-amount 0.34999999999999998)
    (fade-length 138)
    (fade-unit percent))
(use-fg-bg yes)
(use-opacity-paint-mode yes)
(use-brush yes)
(use-dynamics yes)
(use-mypaint-brush no)
(use-gradient no)
(use-pattern yes)
(use-palette no)
(use-font no)

# end of GIMP tool preset file
