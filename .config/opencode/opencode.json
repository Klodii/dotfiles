{
    "$schema": "https://opencode.ai/config.json",
    "lsp": true,
    "provider": {
        "litellm": {
            "npm": "@ai-sdk/openai-compatible",
            "name": "LiteLLM",
            "options": {
                "baseURL": "{env:LITELLM_API_URL}",
                "apiKey":  "{env:LITELLM_API_KEY}"
            },
            "models": {
                "smart-router": {
                    "name": "smart-router"
                }
            }
        }
    },
    "permission": {
        "bash": {
            "*": "allow",
            "rm -rf*": "ask",
            "git push*": "ask",
            "git reset --hard*": "ask",
            "git clean*": "ask",
            "npm publish*": "ask"
        },
        "external_directory": {
            "~/.ssh/**": "deny",
            "~/.aws/**": "deny",
            "**/.env*": "ask"
        }
    }
}
