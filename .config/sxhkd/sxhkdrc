# Example file in /usr/share/doc/bspwm/examples/sxhkdrc

# Restart sxhkd config file (if you edit this file)
super + Escape
    pkill -USR1 -x sxhkd
# Restart bspwm configuration
super + r
	bspc wm -r
# Quit bspwm (LogOut)
super + alt + q
	bspc quit
# Shutdown PC
super + alt + s
    bspc quit && systemctl poweroff
# Restart PC
super + alt + r
    bspc quit && systemctl reboot
# Lock screen
super + alt + l
    i3lock


# Close focused window
super + q
    bspc node -c

# Launch a terminal
super + {Return,BackSpace}
    alacritty

# Launch a browser
super + w
    zen
#
# Do a screenshot
super + s
    ~/.local/bin/screenshot

# Do a screenshot and open it with ksnip
super + shift + s
    ~/.local/bin/screenshot -k
#
# Do a screenshot and open it with gimp
super + shift + g
    ~/.local/bin/screenshot -g

# Launch image editor
# wacom-setup is a custom script that configures the wacom tablet buttons and
# pen pressure
super + g
    ~/.local/bin/wacom-setup > /tmp/wacom.log 2>&1 ; gimp

# Application luncher
super + p
    rofi -show combi -modes combi -combi-modes "window,drun,run"

# Toggle camera on/off on Teams
# ctrl + shift + o is the keybinging of teams to turn the camera on/off
# the spleep is needed in order to way the release of `alt+o` from the user
alt + v
    sleep 0.2; xdotool key --clearmodifiers ctrl+shift+o

# Toggle mute/unmute microphone on Teams
# sctrl + shift + m is the keybinging of teams to turn the microphone on/off
# the spleep is needed in order to way the release of `alt+m` from the user
alt + m
    sleep 0.2; xdotool key --clearmodifiers ctrl+shift+m

# ---- WINDOW FOCUS ----
# Focus next/previous window
super + {j,k}
    bspc node -f {next,prev}.local

# Focus in cardinal directions
super + {h,j,k,l}
    bspc node -f {west,south,north,east}

# ---- WINDOW MOVEMENT ----
# Move window in cardinal directions
super + shift + {h,j,k,l}
    bspc node -s {west,south,north,east}

# ---- DESKTOPS ----
# Switch to desktop 0–9
super + {0-9}
    bspc desktop -f {0-9}

# Move focused window to desktop 0–9
super + shift + {0-9}
    bspc node -d {0-9}

# Change layout to tiled
super + shift + t
    bspc desktop -l tiled

# Change layout to monocle
super + shift + m
    bspc desktop -l monocle

# Switch between layouts
super + shift + n
    bspc desktop -l next

# ---- LAYOUT ----
# Toggle floating mode
super + space
    bspc node -t ~floating

# Balance window sizes
super + b
    bspc node @/ -B

# ---- SYSTEM / UTILITY ----
# Volume buttons
XF86AudioRaiseVolume
    amixer -q sset Master 5%+

XF86AudioLowerVolume
    amixer -q sset Master 5%-

XF86AudioMute
    amixer -q sset Master toggle

# Volume keys with my custom script
F10
    vc -n up
F11
    vc -n down
F12
    vc -n toggle


# Brightness
XF86MonBrightnessUp
    brightnessctl s +5%

XF86MonBrightnessDown
    brightnessctl s 5%-
